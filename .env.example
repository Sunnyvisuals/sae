# Supabase — constellation collective (Acte III, partagée entre tous les visiteurs)
# Vercel (recommandé) : npx vercel integration add supabase --name al-rihla-constellation
#   puis npm run db:constellation (avec vercel env pull .env.production.local)
# Manuel : créer un projet sur supabase.com, exécuter supabase/constellation_stars.sql, renseigner ci-dessous

# Dev local (Vite) — client direct
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Vercel (prod) — route /api/constellation (recommandé, sans exposer la clé au bundle)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Reset BDD comètes (panneau dev « Reset BDD comètes ») — jamais dans le bundle client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optionnel : autoriser DELETE en prod (déconseillé). Sinon : dev + preview Vercel uniquement.
# ALLOW_DEV_CONSTELLATION_RESET=true

# Sans config : en dev, étoiles démo locales ; en prod, ciel vide jusqu’à configuration.

# ── Prologue vidéo ─────────────────────────────────────────────────────────
# Prod (Vercel) : /Prologue.web.mp4 sur alrihla.art (+ copie legacy Prologue.mp4 au build).
#   npm run assets:prologue:web   puis commit public/Prologue.web.mp4
# Sur Vercel : supprime VITE_INTRO_VIDEO_URL si elle pointe vers Bunny (sinon build sans MP4).
#
# Bunny Stream (play_1080p / m3u8) : 403 en accès direct — ne pas l’utiliser en prod.
# Dev : laisse VITE_INTRO_VIDEO_URL vide → public/Prologue.web.mp4 (~34 Mo, pas le master 340 Mo)
