# Supabase — constellation collective (Acte III, partagée entre tous les visiteurs)
# 1. Créer un projet sur supabase.com
# 2. Exécuter supabase/constellation_stars.sql dans le SQL Editor
# 3. Renseigner les clés ci-dessous

# Dev local (Vite) — client direct
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Vercel (prod) — route /api/constellation (recommandé, sans exposer la clé au bundle)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Reset BDD comètes (panneau dev « Reset BDD comètes ») — jamais dans le bundle client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optionnel : autoriser DELETE en prod (déconseillé). Sinon : dev + preview Vercel uniquement.
# ALLOW_DEV_CONSTELLATION_RESET=true

# Sans config : en dev, étoiles démo locales ; en prod, ciel vide jusqu’à configuration.

# ── Prologue vidéo (prod = Bunny Stream ou CDN, obligatoire sur Vercel) ─────
#
# Bunny Stream — utilise l’URL playlist HLS (PAS le lien player.mediadelivery.net) :
# VITE_INTRO_VIDEO_URL=https://vz-b0e81311-954.b-cdn.net/5cdd6a54-5491-4bba-b34b-e6ed79c32de4/playlist.m3u8
#
# Si « MP4 Fallback » est activé dans la librairie Stream, tu peux aussi utiliser :
# VITE_INTRO_VIDEO_URL=https://vz-b0e81311-954.b-cdn.net/5cdd6a54-5491-4bba-b34b-e6ed79c32de4/play_1080p.mp4
#
# Bunny → Stream → ta vidéo → Security : autorise alrihla.art (et localhost en dev)
# Bunny → Stream → Enable CORS (tuto volume / Web Audio)
#
# Vercel → Settings → Environment Variables → VITE_INTRO_VIDEO_URL → Redeploy
#
# Dev local sans CDN : laisse vide + public/Prologue.web.mp4 (npm run assets:prologue:web)
